# Copy to `.env.local` and fill in. Validated at startup by src/config/env.ts.

# TMDB credentials: https://www.themoviedb.org/settings/api
# Accepts either the v3 API key or the v4 "API Read Access Token" (starts with "eyJ").
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Public: exposed to the browser.
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
